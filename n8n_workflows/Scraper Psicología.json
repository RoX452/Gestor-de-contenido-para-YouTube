      "name": "Extraer HTML del Canal"
    },
    {
      "parameters": {
        "jsCode": "return $input.all().map(item => {\n  const html = item.json.data;\n  const urlLimpia = item.json.url_limpia;\n  let channelId = null;\n\n  const match = html.match(/channel_id=(UC[\\w-]+)/);\n  if (match && match[1]) {\n    channelId = match[1];\n  } else {\n    const matchMeta = html.match(/\"browseId\":\"(UC[\\w-]+)\"/);\n    if (matchMeta && matchMeta[1]) {\n      channelId = matchMeta[1];\n    }\n  }\n\n  if (!channelId) {\n    channelId = \"ID_NO_ENCONTRADO_REVISAR_URL\";\n  }\n\n  return { json: { \"channel-id\": channelId, canal_base: urlLimpia } };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
