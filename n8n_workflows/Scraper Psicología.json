    {
      "parameters": {
        "jsCode": "const inputData = items[0].json.data;\nconst existingLinks = new Set();\nconst newUrls = [];\n\nfor (const obj of inputData) {\n  if (obj[\"['Source Video URL']\"]) {\n    existingLinks.add(obj[\"['Source Video URL']\"]);\n  } else if (obj.url) {\n    newUrls.push(obj.url);\n  }\n}\n\nconst filteredUniqueNew = new Set(newUrls.filter(url => !existingLinks.has(url)));\nreturn [...filteredUniqueNew].map(url => ({ json: { url } }));"
