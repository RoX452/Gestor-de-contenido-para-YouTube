    {
      "parameters": {
        "jsCode": "// Run Once for All Items - filters videos and outputs only URLs\nconst NOW = new Date(); \n\nfunction hoursSince(dateIso) {\n  const d = new Date(dateIso);\n  if (isNaN(d.getTime())) return Infinity; \n  return (NOW - d) / 36e5; \n}\n\nfunction passes(video) {\n  const views = Number(video?.views ?? 0);\n  const ageH = hoursSince(video?.published);\n  if (ageH > 48) return false;\n  if (views > 7000) return true;\n  if (views >= 4000 && ageH <= 12) return true;\n  return false;\n}\n\nconst input = items[0].json ?? items[0];\nconst data = Array.isArray(input.data) ? input.data : [];\n\nconst filtered = data.filter(passes);\n\nreturn filtered.map(video => {\n  return {\n    json: {\n      url: video.url\n    }\n  };\n});"
      },
