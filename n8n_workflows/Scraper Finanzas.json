    {
      "parameters": {
        "jsCode": "const rawUrls = $input.first().json.lista_urls || \"\";\nconst urls = rawUrls.split('\\n').map(u => u.trim()).filter(u => u);\n\nreturn urls.map(url => {\n  let cleanUrl = url.split('?')[0];\n  cleanUrl = cleanUrl.replace(/\\/videos\\/?$/, '').replace(/\\/featured\\/?$/, '').replace(/\\/shorts\\/?$/, '');\n  return { json: { url_original: url, url_limpia: cleanUrl } };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -2048,
        256
      ],
      "id": "8bde8c4c-69e5-4417-9af1-8c61aa66308c",
