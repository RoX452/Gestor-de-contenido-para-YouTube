    {
      "parameters": {
        "jsCode": "if (!items[0] || !items[0].json || !items[0].json.feed || !items[0].json.feed.entry) return [];\n\nconst entries = items[0].json.feed.entry;\nconst extractedVideos = (Array.isArray(entries) ? entries : [entries]).map(entry => {\n  return {\n    url: entry.link?.href || '',\n    title: entry.title || '',\n    views: parseInt(entry['media:group']?.['media:community']?.['media:statistics']?.views || 0, 10),\n    published: entry.published || ''\n  };\n});\n\nextractedVideos.sort((a, b) => new Date(b.published) - new Date(a.published));\nreturn extractedVideos.map(video => ({ json: video }));"
      },
